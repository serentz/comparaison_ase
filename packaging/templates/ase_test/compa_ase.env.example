# ============================================================
# compA_ase : parametres de l'archive « serveurs ASE de test » (POC)
# Copier ce fichier en scripts/compa_ase.env, adapter, puis : sudo ./install.sh
# Le mot de passe sa n'est JAMAIS dans ce fichier : il est saisi au clavier.
# ============================================================
SYBASE_DIR=/opt/sap          # dossier ou SAP ASE 16.0 est deja decompresse/installe (SYBASE.sh dedans)
ASE_NAME=ASE1                # nom du serveur ASE a creer (ASE1 sur ase01, ASE2 sur ase02)
ASE_PORT=5000                # port TCP
ASE_PAGE_SIZE=4k             # taille de page : 2k, 4k, 8k ou 16k (identique sur les 2 serveurs)
ASE_INSTANCE=1               # 1 ou 2 : script de base de test a charger (ecarts voulus entre 1 et 2)
ASE_USER=                    # proprietaire Linux de SYBASE_DIR ; vide = proprietaire du dossier

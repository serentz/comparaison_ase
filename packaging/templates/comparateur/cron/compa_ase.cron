# compA_ase : equivalent cron du timer systemd compa_ase-planifie.
# A N'UTILISER QUE si systemd ne convient pas (ne pas activer les deux).
#
# Installation :  sudo cp cron/compa_ase.cron /etc/cron.d/compa_ase     (remplacer RUN_USER ci-dessous par le login Linux)
# Les comparaisons lancees sont celles de /etc/compa_ase/planifie.conf. Sortie dans le journal systeme :
# journalctl -t compa_ase-planifie
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Tous les jours a 02:30
30 2 * * * RUN_USER /usr/local/bin/compa_ase-planifie 2>&1 | logger -t compa_ase-planifie

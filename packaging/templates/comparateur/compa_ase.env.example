# ============================================================
# compA_ase : parametres de l'archive « comparateur » (machine qui lance les comparaisons)
# Copier ce fichier en scripts/compa_ase.env, adapter, puis : sudo ./install.sh
# compa_ase.env contient un mot de passe : ne jamais le versionner.
# ============================================================
# Base de resultats (archive « depot »)
PG_HOST=192.168.50.11
PG_PORT=5432
PG_DB=compa
PG_USER=compa_app
PG_PASSWORD=CHANGEME_compa_app

INSTALL_DIR=/opt/compa_ase             # programmes (compare_ase.sh, requetes, compare.py)
RUN_USER=                             # login Linux qui lance les comparaisons ; vide = l'utilisateur qui a lance sudo
ENABLE_SCHEDULE=0                     # 1 = active la comparaison planifiee quotidienne (timer systemd), voir LISEZMOI.md
SYBASE_ENV_FILE=/opt/sap/SYBASE.sh    # script SYBASE.sh du client SAP (isql) ; vide = isql deja dans le PATH
ASE_LANG=en_US.UTF-8                  # jeu de caracteres des sessions isql
